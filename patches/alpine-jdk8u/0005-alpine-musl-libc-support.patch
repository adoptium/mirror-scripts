+#ifdef MUSL_LIBC
+  // dlvsym is not a part of POSIX and musl libc doesn't implement it.
+  static void *dlvsym(void *handle, const char *name, const char *ver)
+  {
+    return dlsym(handle, name);
+  }
+#endif
